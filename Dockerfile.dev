# Node 22: pnpm 11 usa `node:sqlite`, un módulo interno que no existe antes de
# Node 22.5. Con node:20 la instalación de dependencias aborta con
# ERR_UNKNOWN_BUILTIN_MODULE.
FROM node:22-alpine

WORKDIR /app

# Versión de pnpm FIJADA, y por npm en lugar de corepack.
#
# `corepack enable pnpm` instala la última versión publicada, de modo que la
# imagen dependía de qué hubiera en el registro el día de la construcción.
# Corepack está además en desuso.
RUN npm install --global pnpm@11.24.0

# `pnpm-workspace.yaml` es necesario en este punto: declara qué dependencias
# pueden ejecutar scripts de instalación. Sin él, pnpm 11 termina con
# ERR_PNPM_IGNORED_BUILDS y la construcción falla.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 3000

# Se invoca el binario directamente y no vía `pnpm exec` ni `npx`: `pnpm exec`
# comprueba antes el estado de las dependencias y, si el `node_modules` del
# volumen quedó desfasado respecto al lockfile montado, intenta purgarlo, no
# encuentra TTY y aborta el arranque
# (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY). El contenedor sólo tiene que
# ejecutar lo que ya se instaló al construir la imagen.
CMD ["node_modules/.bin/nodemon", "--legacy-watch", "--polling-interval", "1000", \
     "src/server.js"]
