# Secretos de SPACE. scripts/dev-up.sh genera space/.env con valores aleatorios
# la primera vez; este fichero solo documenta los nombres. Ninguno tiene valor
# por omisión en el compose: si falta uno, `docker compose` no arranca.

# Firma de los tokens de pricing (HS256 con una clave derivada por PBKDF2 de los dos).
SPACE_JWT_SECRET=
SPACE_JWT_SALT=

# Administrador que crea SPACE en su primer arranque. Si el volumen ya existe
# con otro administrador, cambiar estos valores no cambia nada.
SPACE_ADMIN_USER=admin
SPACE_ADMIN_PASSWORD=

# Usuario root del MongoDB de SPACE, con el que se conecta el servidor.
SPACE_MONGO_ROOT_USERNAME=space
SPACE_MONGO_ROOT_PASSWORD=
