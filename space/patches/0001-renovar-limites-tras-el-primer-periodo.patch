--- a/api/src/main/services/ContractService.ts
+++ b/api/src/main/services/ContractService.ts
@@ -820,10 +820,15 @@ class ContractService {
           contractToUpdate.contractedServices[serviceName],
           organizationId
         );
-        currentResetTimeStamp = addPeriodToDate(
-          currentResetTimeStamp,
-          pricing.usageLimits![usageLimitName].period!
-        );
+        const period = pricing.usageLimits![usageLimitName].period!;
+        const now = new Date();
+        let nextResetTimeStamp = new Date(currentResetTimeStamp);
+        // Advance whole periods until the reset lies in the future, and store it:
+        // a reset left in the past makes every later evaluation reset the level again.
+        while (period.value > 0 && !isAfter(nextResetTimeStamp, now)) {
+          nextResetTimeStamp = addPeriodToDate(nextResetTimeStamp, period);
+        }
+        contractToUpdate.usageLevels[serviceName][usageLimitName].resetTimeStamp = nextResetTimeStamp;
         contractToUpdate.usageLevels[serviceName][usageLimitName].consumed = 0;
       }
     }
