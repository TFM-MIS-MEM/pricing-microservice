#!/bin/sh
pnpm exec commitlint --edit "$1" --verbose || {
  echo ""
  echo "❌ Invalid commit message"
  echo "Your commit message must follow Conventional Commits:"
  echo "   <type>: <brief description>"
  echo ""
  echo "Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, sec"
  echo "Valid example: feat: add login endpoint"
  echo ""
  exit 1
}
