# ===================================================
# Ejecución local (pnpm run dev)
# MongoDB corriendo en la máquina local
# ===================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

MONGODB_URI=mongodb://localhost:27018/pricing-db

# ===================================================
# Security M2M — Comunicación interna entre microservicios
# Debe coincidir con el valor de auth-microservice y Kong
# ===================================================
INTERNAL_API_SECRET=dev_internal_secret_key_789

# ===================================================
# JWT — Para validar tokens emitidos por Auth
# Debe coincidir con el JWT_SECRET de auth-microservice
# ===================================================
JWT_SECRET=change_me_with_a_64_byte_random_hex_string

# ===================================================
# Stripe — Integración de pagos
# Generados en https://dashboard.stripe.com/test/apikeys
# ===================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ===================================================
# API metadata (usada por Swagger/OpenAPI)
# ===================================================
API_TITLE=Pricing Microservice API
API_DESCRIPTION=Gestión de suscripciones, webhooks Stripe y auditoría de consumo — TFM SaaS Reconocimiento Facial

# ===================================================
# Ejecución dentro de Docker Compose
# El hostname debe coincidir con el container_name
# del servicio mongodb definido en docker-compose.dev.yml
# ===================================================
# MONGODB_URI=mongodb://pricing-mongodb:27017/pricing-db

# ===================================================
# Credenciales de MongoDB (requeridas en Docker)
# ===================================================
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
