# ===================================================
# Ejecución local (pnpm run dev)
# MongoDB corriendo en la máquina local
# ===================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

MONGODB_URI=mongodb://localhost:27018/pricing-db

# ===================================================
# Security M2M — Comunicación interna entre microservicios
# Debe coincidir con el valor de auth-microservice y Kong
# ===================================================
INTERNAL_API_SECRET=dev_internal_secret_key_789

# ===================================================
# Identidad
# ===================================================
# Este servicio NO verifica tokens: la identidad llega resuelta por la pasarela
# en X-Account-Id, X-Auth-Channel y X-Role (issue #65). Por eso aquí ya no está
# el secreto de firma de auth: si alguna vez vuelve a hacer falta, el cambio
# está a medias.

# ===================================================
# Stripe — Integración de pagos
# Generados en https://dashboard.stripe.com/test/apikeys
# ===================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Precio de cada plan de pago, tal y como lo publica el panel de Stripe. El
# cliente envía `planId` (free | pro | business) y el servicio lo traduce aquí:
# el Price ID no cruza la frontera de la API.
#
# SIN valor por defecto en el código, a propósito: el servicio NO ARRANCA si
# falta alguno. Un identificador de precio inventado no falla al arrancar, falla
# en la primera compra real. El plan gratuito no aparece: no hay nada que cobrar.
STRIPE_PRICE_PRO=price_your_pro_plan_price_id_here
STRIPE_PRICE_BUSINESS=price_your_business_plan_price_id_here

# ===================================================
# SPACE — contratos de las cuentas (#51)
# Los escribe scripts/space-bootstrap.sh. Clave de organización (org_…), de
# ámbito MANAGEMENT. Sin ellos el servicio no arranca (src/config/space.js).
# ===================================================
SPACE_URL=http://space-server:3000
SPACE_API_KEY=org_la_emite_space_bootstrap

# ===================================================
# API metadata (usada por Swagger/OpenAPI)
# ===================================================
API_TITLE=Pricing Microservice API
API_DESCRIPTION=Gestión de suscripciones, webhooks Stripe y auditoría de consumo — TFM SaaS Reconocimiento Facial

# ===================================================
# Ejecución dentro de Docker Compose
# El hostname debe coincidir con el container_name
# del servicio mongodb definido en docker-compose.dev.yml
# ===================================================
# MONGODB_URI=mongodb://pricing-mongodb:27017/pricing-db

# ===================================================
# Credenciales de MongoDB (requeridas en Docker)
# ===================================================
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
